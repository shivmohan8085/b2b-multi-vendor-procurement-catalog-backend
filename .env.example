# ===========================================
# Django Core Settings
# ===========================================

# SECRET_KEY - Generate new one using:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars

# DEBUG - Set to False in production
DEBUG=True

# ALLOWED_HOSTS - Comma separated
ALLOWED_HOSTS=localhost,127.0.0.1

# ===========================================
# Database Settings
# ===========================================

# Set USE_SQLITE=True for zero-setup development (SQLite)
# Set USE_SQLITE=False to use PostgreSQL (production)
USE_SQLITE=True

# PostgreSQL settings (only used when USE_SQLITE=False)
DB_NAME=procureflow_dev
DB_USER=your_postgres_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# ===========================================
# Redis Settings
# ===========================================

# Redis for caching (database 1)
REDIS_URL=redis://127.0.0.1:6379/1

# Redis as Celery message broker (database 0)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0

# ===========================================
# CORS Settings (Frontend Origins)
# ===========================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# Email Settings (SMTP)
# ===========================================

# For production/testing, use SMTP:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Gmail App Password: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=your_gmail@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=your_gmail@gmail.com